<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.namikofficial.author-clipboard</id>
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Author Clipboard</name>
  <summary>Native COSMIC clipboard manager with wlroots compositor support</summary>

  <description>
    <p>
      Author Clipboard is a native COSMIC clipboard manager with wlroots compositor
      support, including Hyprland and Sway. It monitors your clipboard history,
      provides instant full-text search, and keeps your sensitive data safe with
      automatic detection and optional encryption.
    </p>
    <p>Features:</p>
    <ul>
      <li>Persistent clipboard history stored in SQLite with FTS5 full-text search</li>
      <li>Sensitive content detection (passwords, API keys, tokens, SSH keys)</li>
      <li>AES-256-GCM encryption for sensitive items</li>
      <li>Emoji, symbol, and kaomoji pickers</li>
      <li>Pin frequently used items</li>
      <li>Quick paste via keyboard shortcuts</li>
      <li>Screen lock integration — clear sensitive items on lock</li>
      <li>Export and import clipboard history</li>
      <li>Wayland-native using wlr-data-control protocol</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.namikofficial.author-clipboard.desktop</launchable>

  <url type="homepage">https://github.com/namikofficial/author-clipboard</url>
  <url type="bugtracker">https://github.com/namikofficial/author-clipboard/issues</url>
