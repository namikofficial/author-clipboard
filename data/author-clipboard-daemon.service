[Unit]
Description=Author Clipboard Daemon - Clipboard history monitor
Documentation=https://github.com/namikofficial/author-clipboard
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/author-clipboard-daemon
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
