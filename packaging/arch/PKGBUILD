# Maintainer: Namik <namikofficial@users.noreply.github.com>
pkgname=author-clipboard
pkgver=0.5.0
pkgrel=1
pkgdesc='Native COSMIC clipboard manager with wlroots compositor support'
arch=('x86_64')
url='https://github.com/namikofficial/author-clipboard'
license=('GPL-3.0-or-later')
depends=('wayland' 'wl-clipboard' 'sqlite' 'libxkbcommon')
makedepends=('rust' 'cargo' 'pkgconf' 'wayland-protocols' 'gtk4')
optdepends=(
  'wtype: preferred quick paste backend on Wayland'
  'ydotool: optional input automation backend'
  'wofi: external menu picker for clipboard history'
  'fuzzel: minimal external menu picker alternative'
  'rofi: feature-rich external menu picker alternative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
        "gtk4-layer-shell::https://aur.archlinux.org/gtk4-layer-shell.git")
sha256sums=('SKIP'
            'SKIP')

build() {
  # Build gtk4-layer-shell from AUR if not installed
  if ! pacman -Qs gtk4-layer-shell > /dev/null 2>&1; then
    cd "$srcdir/gtk4-layer-shell"
    makepkg --noconfirm --skippgpcheck
    pacman --noconfirm --upgrade gtk4-layer-shell-*.pkg.tar.zst
  fi

  cd "$pkgname-$pkgver"
  cargo build --release --workspace --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/author-clipboard "$pkgdir/usr/bin/author-clipboard"
  install -Dm755 target/release/author-clipboard-daemon "$pkgdir/usr/bin/author-clipboard-daemon"
  install -Dm755 target/release/author-clipboard-ctl "$pkgdir/usr/bin/author-clipboard-ctl"
  install -Dm755 target/release/author-clipboard-hypr-picker "$pkgdir/usr/bin/author-clipboard-hypr-picker"

  install -Dm644 data/author-clipboard-daemon.service \
    "$pkgdir/usr/lib/systemd/user/author-clipboard-daemon.service"
  install -Dm644 data/com.namikofficial.author-clipboard.desktop \
    "$pkgdir/usr/share/applications/com.namikofficial.author-clipboard.desktop"
  install -Dm644 data/com.namikofficial.author-clipboard.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.namikofficial.author-clipboard.metainfo.xml"
  install -Dm644 resources/icons/com.namikofficial.author-clipboard.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.namikofficial.author-clipboard.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
